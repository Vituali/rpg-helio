# Caddyfile — front estático + proxy do WebSocket do jogo.
#
# O Caddy é a única porta para o mundo: serve o front em /srv e repassa
# /socket.io/* para o serviço `app` (Node + Socket.IO). O app não é publicado
# no host — ver docker-compose.yml.

# ── Opção A: acesso público com DuckDNS (HTTPS automático) ──────────────────
# Troque helio.duckdns.org pelo seu subdomínio. Precisa das portas 80 e 443
# abertas no roteador e de IP público (sem CGNAT).
helio.duckdns.org {
	encode zstd gzip

	# WebSocket do jogo: precisa vir ANTES do handle geral.
	handle /socket.io/* {
		reverse_proxy app:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html   # SPA: qualquer rota cai no index
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ── Opção B: IP FIXO + sslip.io (grátis, sem DDNS) — RECOMENDADO p/ IP fixo ──
# Com IP público FIXO, o sslip.io embute o IP no próprio hostname e o Caddy
# emite o certificado normalmente. Não precisa de DuckDNS nem de registrar IP
# dinâmico. Troque pelos SEUS octetos (pontos viram hífens).
# 189-40-12-7.sslip.io {
# 	encode zstd gzip
# 	handle /socket.io/* {
# 		reverse_proxy app:3000
# 	}
# 	handle {
# 		root * /srv
# 		try_files {path} /index.html
# 		file_server
# 	}
# }

# ── Opção C: Tailscale (rede privada, sem abrir porta) ──────────────────────
# Comente o bloco acima e use este. O hostname é o nome da máquina na tailnet,
# ex.: helio-pc.tailXXXX.ts.net . O TLS sai via `tailscale cert`.
# helio-pc.tailXXXX.ts.net {
# 	encode zstd gzip
# 	handle /socket.io/* {
# 		reverse_proxy app:3000
# 	}
# 	handle {
# 		root * /srv
# 		try_files {path} /index.html
# 		file_server
# 	}
# }

# ── Opção D: HTTP puro no IP (sem HTTPS, sem domínio) ───────────────────────
# Funciona pro jogo, mas quebra voz/WebRTC depois (getUserMedia exige HTTPS).
# :80 {
# 	handle /socket.io/* {
# 		reverse_proxy app:3000
# 	}
# 	handle {
# 		root * /srv
# 		try_files {path} /index.html
# 		file_server
# 	}
# }

# ── Desafio ACME (Let's Encrypt) num IP pelado: não é possível ──────────────
# Por isso as opções acima usam domínio (DuckDNS/Tailscale) ou HTTP puro.
