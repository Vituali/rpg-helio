# Copie para `.env` e preencha. O `docker compose` lê este arquivo sozinho.

# ── Servidor de jogo ────────────────────────────────────────────────────────
# Sala padrão: quem entrar sem escolher um código cai nesta.
ROOM_CODE=HELIO

# CORS/WebSocket. Como TODO o tráfego passa pelo Caddy (mesma origem),
# "*" funciona e é o mais simples. Só restrinja se expuser o app direto.
ORIGIN=*

# ── Opcional: DuckDNS (Opção A do Caddyfile) ────────────────────────────────
# Token do DuckDNS (https://www.duckdns.org) — NÃO versione o `.env`
DUCKDNS_TOKEN=
