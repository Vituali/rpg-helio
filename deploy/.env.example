# Copie para `.env` e preencha. O `docker compose` lê este arquivo sozinho.

# ── Fase 2 ────────────────────────────────────────────────────────────────
# Código padrão da sala criada na subida do servidor
ROOM_CODE=HELIO
# Origem permitida nos CORS/WebSocket (batendo com o Caddyfile)
ORIGIN=https://helio.duckdns.org

# ── Opcional: DuckDNS (Opção A do Caddyfile) ──────────────────────────────
# Token do DuckDNS (https://www.duckdns.org) — NÃO versione o `.env`
DUCKDNS_TOKEN=
